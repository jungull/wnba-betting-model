  "F8_totals_market_correction": {
    "severity": "B",
    "claim": "P29 reported 'Markets present: odds_spread and odds_price. No totals column.' That is a correction in BOTH directions.",
    "corrected_to": "A totals market DOES exist, in master_odds_extension_other_markets.csv, which P29 did not open (27820 totals rows). But it covers only ['2025', '2026']. The pace-relevant member of the family -- the market total, which is what the packet's candidate entry actually names -- has NO history before 2025-07-05.",
    "totals_games_by_season": {
      "2025": 197,
      "2026": 209
    },
    "consequence": "The archive that reaches back to 2022-05-21 carries spread and price only. Discovering a 2022 archive therefore does NOT supply history for the feature the packet was actually contemplating."
  },
